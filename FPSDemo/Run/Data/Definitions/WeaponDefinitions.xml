<Definitions>
  <!-- Pistol -->
  <WeaponDefinition name="Pistol" magazineSize="20" reserveAmmo="100" reloadTime="1.5">
    <MainAttack refireTime="0.35" rayCount="1" rayCone="0.0" rayRange="12.0" rayDamage="25" rayImpulse="4.0" doesCharge="false" duration="0.0"/>
    <HUD shader="Default" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16" spriteSize="256,256" spritePivot="0.5,0.0">
      <Animation name="Idle" shader="Default" spriteSheet="Data/Images/Weapon_Pistol.png" cellCount="5,1" secondsPerFrame="0.1" startFrame="0" endFrame="0"/>
      <Animation name="Attack" shader="Default" spriteSheet="Data/Images/Weapon_Pistol.png" cellCount="5,1" secondsPerFrame="0.1" startFrame="1" endFrame="3" />
    </HUD>
    <Sounds>
      <Sound sound="Fire" name="Data/Audio/PistolFire.wav"/>
    </Sounds>
  </WeaponDefinition>
  <!-- Plasma Rifle -->
  <WeaponDefinition name="PlasmaRifle" magazineSize="50" reserveAmmo="250" reloadTime="2.0">
    <MainAttack refireTime="0.5" projectileCount="1" projectileActor="PlasmaProjectile" projectileSpeed="6.0" doesCharge="true" chargeTime="0.6" chargeAmmoCost="10" duration="0.0"/>
    <SubAttack refireTime="2" meleeCount="8" meleeArc="90.0" meleeRange="1.0" meleeDamage="8" meleeImpulse="1.5" doesCharge="false" damageDelay="0.20" ammoPerShot="0"/>
    <HUD shader="Default" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16" spriteSize="256,256" spritePivot="0.5,0.0">
      <Animation name="Idle" shader="Default" spriteSheet="Data/Images/Weapon_Plasma.png" cellCount="4,1" secondsPerFrame="0.125" startFrame="0" endFrame="0" />
      <Animation name="Attack" shader="Default" spriteSheet="Data/Images/Weapon_Plasma.png" cellCount="4,1" secondsPerFrame="0.125" startFrame="1" endFrame="2" />
      <Animation name="Melee" shader="Default" spriteSheet="Data/Images/Weapon_Plasma.png" cellCount="4,1" secondsPerFrame="1.0" startFrame="3" endFrame="3" />
    </HUD>
    <Sounds>
      <Sound sound="Fire" name="Data/Audio/PlasmaFire.wav"/>
    </Sounds>
  </WeaponDefinition>
